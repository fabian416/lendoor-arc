# /opt/docker/lendoor-arc/.env — base: copiar el .env de staging y pisar/agregar estas líneas.
# ETH_PRIVATE_KEY = la wallet descartable que es owner() del LoanManagerV3 de Arc (NUNCA la de prod).
ETH_PRIVATE_KEY=0x...
ETH_RPC_URL="https://rpc.testnet.arc.io"
ETH_RPC_URL2="https://rpc.testnet.arc.io"
ETH_LOAN_MANAGER="0x42C61140c0c2f0eb85f73DB66c730F48000ce1C9"
ETH_USDC="0x3600000000000000000000000000000000000000"
ETH_EVAULT="0xc90F69f03B0f50ECfFE84ded906be678111Afc0c"
POSTGRES_HOST=database-arc
POSTGRES_USER=lendoor_arc
POSTGRES_DB=lendoor_arc
REDIS_HOST=redis-arc
BACKEND_URL="https://arc.lendoor.xyz/api"
RISK_SCORING_ENABLED=false
VOICE_AGENT_ENABLED=false
VOICE_PROPOSAL_ENABLED=0
LEMON_PENNY_ENABLED=false
PHONE_OTP_DEV_BYPASS=true
# Borrar del .env copiado: KAPSO_API_KEY, KAPSO_PHONE_NUMBER_ID, RISK_API_URL (el OTP se loguea en la consola del backend).
